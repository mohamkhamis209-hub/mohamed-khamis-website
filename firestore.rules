rules_version = '2';service cloud.firestore{match /databases/{database}/documents{function signed(){return request.auth!=null;}function root(){return signed()&&request.auth.uid=="6kUrmstc69T4AnwhoUJ4ZrFbRez2";}function existsAdmin(){return signed()&&exists(/databases/$(database)/documents/admins/$(request.auth.uid));}function admin(){return root()||(existsAdmin()&&get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active==true);}function can(p){return root()||(admin()&&get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.permissions[p]==true);}match /admins/{uid}{allow read:if root()||(signed()&&request.auth.uid==uid);allow write:if root();}match /projects/{id}{allow read:if resource.data.published==true||can("manageProjects");allow write:if can("manageProjects");}match /services/{id}{allow read:if resource.data.published==true||can("manageServices");allow write:if can("manageServices");}match /faqs/{id}{allow read:if resource.data.published==true||can("manageFaqs");allow write:if can("manageFaqs");}match /testimonials/{id}{allow read:if resource.data.published==true||can("manageTestimonials");allow write:if can("manageTestimonials");}match /settings/{id}{allow read:if id=="public"||can("manageSettings");allow write:if can("manageSettings");}match /requests/{id}{allow create:if false;allow read,update,delete:if can("manageRequests");}match /messages/{id}{allow create:if false;allow read,update,delete:if can("manageMessages");}match /requestRateLimits/{id}{allow read,write:if false;}match /{doc=**}{allow read,write:if false;}}}