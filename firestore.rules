rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function superAdmin() {
      return signedIn() && (
        request.auth.uid == '6kUrmstc69T4AnwhoUJ4ZrFbRez2' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin' &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true)
      );
    }
    function activeAdmin() {
      return superAdmin() || (signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true);
    }
    function can(permission) {
      return superAdmin() || (activeAdmin() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.permissions[permission] == true);
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || superAdmin());
      allow write: if superAdmin();
    }
    match /settings/{id} {
      allow read: if id == 'public' || activeAdmin();
      allow write: if can('manageSettings');
    }
    match /projects/{id} {
      allow read: if resource.data.published == true || activeAdmin();
      allow write: if can('manageProjects');
    }
    match /services/{id} {
      allow read: if resource.data.published == true || activeAdmin();
      allow write: if can('manageServices');
    }
    match /testimonials/{id} {
      allow read: if resource.data.published == true || activeAdmin();
      allow write: if can('manageTestimonials');
    }
    match /faqs/{id} {
      allow read: if resource.data.published == true || activeAdmin();
      allow write: if can('manageFaqs');
    }

    // Public can submit new requests only; private request data is admin-only.
    match /requests/{id} {
      allow create: if request.resource.data.keys().hasOnly([
          'trackingId','clientName','email','phone','country','projectType','projectDescription',
          'budget','contactMethod','attachmentUrl','status','internalNotes','createdAt','createdAtServer'
        ]) &&
        request.resource.data.keys().hasAll(['trackingId','clientName','email','phone','projectType','projectDescription','status','createdAt','createdAtServer']) &&
        request.resource.data.trackingId == id &&
        request.resource.data.clientName is string && request.resource.data.clientName.size() >= 2 && request.resource.data.clientName.size() <= 120 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 180 && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 50 &&
        request.resource.data.projectType is string && request.resource.data.projectType.size() > 0 &&
        request.resource.data.projectDescription is string && request.resource.data.projectDescription.size() >= 10 && request.resource.data.projectDescription.size() <= 4000 &&
        request.resource.data.status == 'new' && request.resource.data.internalNotes == '' &&
        request.resource.data.createdAtServer == request.time;
      allow read: if can('manageRequests');
      allow update: if can('manageRequests');
      allow delete: if superAdmin();
    }

    // Public can submit new messages only; messages remain private to admins.
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','subject','message','read','archived','createdAt','createdAtServer']) &&
        request.resource.data.keys().hasAll(['name','email','subject','message','read','archived','createdAt','createdAtServer']) &&
        request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 180 && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        request.resource.data.subject is string && request.resource.data.subject.size() >= 3 && request.resource.data.subject.size() <= 180 &&
        request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 5000 &&
        request.resource.data.read == false && request.resource.data.archived == false &&
        request.resource.data.createdAtServer == request.time;
      allow read: if can('manageMessages');
      allow update: if can('manageMessages');
      allow delete: if superAdmin();
    }
    match /auditLogs/{id} {
      allow read: if superAdmin();
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
